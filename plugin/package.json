{
  "name": "decksense-plugin",
  "version": "1.0.0",
  "description": "Stream-Deck-Plugin fÃ¼r DeckSense: zeigt Sensorwerte des Dienstes auf den Tasten.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node tools/make-icons.mjs && rollup --config",
