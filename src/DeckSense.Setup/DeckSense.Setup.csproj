<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DeckSense.Setup</AssemblyName>
    <RootNamespace>DeckSense.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <Product>DeckSense Einrichtung</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Bewusst KEIN requireAdministrator: Das Fenster zeigt den Status ohne
         erhöhte Rechte. Erhöht wird nur, wenn die geplante Aufgabe angelegt
         oder entfernt werden soll - siehe Entscheidung 0020. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Eine Quelldatei aus dem Dienst, verlinkt statt kopiert: Die Prüfung auf
         PawnIO soll in beiden Programmen dieselbe sein. Ein gemeinsames Projekt
         wäre für zwanzig Zeilen zu viel Gerüst. -->
    <Compile Include="..\DeckSense.Service\Interop\PawnIoPresence.cs"
             Link="Interop\PawnIoPresence.cs" />
  </ItemGroup>

</Project>
