{
  // BEISPIEL - diese Datei wird nicht gelesen.
  //
  // DeckSense erzeugt beim ersten Start eine eigene "appsettings.json" neben
  // der Exe, mit den Laufwerken, die auf dem jeweiligen Rechner tatsächlich
  // stecken. Eine vorhandene Datei wird nie überschrieben.
  //
  // Diese Datei zeigt nur, wie das Ergebnis aussieht. Die echte Konfiguration
  // liegt absichtlich nicht im Repository: Sie enthält Seriennummern.
  //
  // Zum Ansehen der erkannten Laufwerke, ohne etwas zu ändern:
  //     DeckSense.Service.exe --detect

  "http": {
    // Reserviert für die HTTP-API. Nicht 8085, das belegt der Webserver von
    // LibreHardwareMonitor.
    "port": 5891
  },

  "intervals": {
    "fastMs": 1000,
    // Laufwerke. Minimum 10000, wird beim Start erzwungen.
    "storageMs": 15000
  },

  "hardware": {
    // CPU-Gruppe von LibreHardwareMonitor. Per Vorgabe aus: Sie wird nur für
    // cpu.temp gebraucht, und das setzt den Kernel-Treiber PawnIO voraus.
    //
    // Einschalten geht über DeckSense.Setup.exe, Knopf „CPU-Temperatur
    // einschalten" - der zeigt vorher, was über Anti-Cheat bekannt ist.
    // Von Hand hier auf true zu stellen tut dasselbe, nur ohne die Warnung.
    "cpu": false,

    // GPU-Werte kommen über NVAPI im Benutzermodus, kein Treiber nötig.
    "gpu": true,

    // Die Laufwerkstemperaturen kommen nicht hierüber, sondern über die
    // Storage-WMI weiter unten.
    "storage": false
  },

  "storage": {
    // Nur diese Laufwerke werden angefasst. Zugeordnet wird über die
    // Seriennummer, nicht über die Laufwerksnummer - Nummern verschieben sich
    // nach einem Portwechsel.
    //
    // Die Id steht in der API und in den Tastenzuordnungen: Wer sie ändert,
    // muss die betroffenen Tasten neu zuweisen. Der Name ist nur der
    // Vorschlag für den Tastentitel und im Plugin überschreibbar.
    "allowed": [
      { "id": "storage.example-ssd-1234", "name": "EXAMPLE SSD", "serial": "SERIAL-NUMBER-HERE" }
    ],

    // Harte Sperre mit Vorrang: Ein Laufwerk hier wird nie abgefragt, auch
    // wenn es gleichzeitig oben steht. Für Laufwerke, die in Ruhe bleiben
    // sollen - etwa weil ihre SMART-Abfrage auffällig war.
    "excluded": []
  },

  "logging": {
    "path": "logs/decksense.log",
    // Debug zeigt zusätzlich die Rohwerte von RTSS.
    "level": "Information",
    "maxFileSizeKb": 1024,
    "maxFiles": 3
  }
}
